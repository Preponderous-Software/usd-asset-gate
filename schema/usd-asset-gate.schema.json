{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Preponderous-Software/usd-asset-gate/main/schema/usd-asset-gate.schema.json",
  "title": "usd-asset-gate configuration (.usd-asset-gate.yml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Path globs to check (default: every USD file)."
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Path globs never to check."
    },
    "fail_on": {
      "enum": [
        "error",
        "warning",
        "info",
        "never"
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Validator names or globs to run (default: all)."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Run validators carrying any of these keywords."
        },
        "disable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Validator names or globs to skip."
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Per-rule settings, keyed by rule ID.",
      "x-unknown-label": "rule",
      "properties": {
        "unresolved-references": {
          "type": "object",
          "description": "References and payloads that point at files which cannot be found (usdUtilsValidators:MissingReferenceValidator, usdValidation:CompositionErrorTest).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            }
          }
        },
        "unresolved-sublayers": {
          "type": "object",
          "description": "Sublayers that cannot be loaded (usdValidation:CompositionErrorTest, usdUtilsValidators:MissingReferenceValidator).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            }
          }
        },
        "default-prim": {
          "type": "object",
          "description": "The stage has a valid defaultPrim (usdValidation:StageMetadataChecker), optionally of a required kind.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "kind": {
              "type": "string",
              "description": "Required kind on the default prim; derived kinds also pass."
            }
          }
        },
        "stage-metadata": {
          "type": "object",
          "description": "upAxis and metersPerUnit are authored (usdGeomValidators:StageMetadataChecker) and, when configured, have the required values.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "metersPerUnit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "upAxis": {
              "enum": [
                "Y",
                "Z"
              ]
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "description": "Absolute tolerance for metersPerUnit (default 1e-9)."
            }
          }
        },
        "file-size": {
          "type": "object",
          "description": "Each file stays under a size limit, checked before the stage is opened.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "max_bytes": {
              "description": "Bytes or a size such as 50MB (SI) / 2GiB (IEC), or a mapping from extension (.usd, .usda, .usdc, .usdz) or 'default' to a size.",
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([KMG]i?)?B\\s*$"
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "default": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([KMG]i?)?B\\s*$"
                        }
                      ]
                    }
                  },
                  "patternProperties": {
                    "^\\.usd[acz]?$": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([KMG]i?)?B\\s*$"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        "prim-budget": {
          "type": "object",
          "description": "Total and per-type prim counts stay within budget (UsdUtils.ComputeUsdStageStats, prototypes included).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "max_prims": {
              "type": "integer",
              "minimum": 0
            },
            "max_by_type": {
              "type": "object",
              "description": "Prim type name -> maximum count, e.g. {Mesh: 5000}.",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "instance-budget": {
          "type": "object",
          "description": "Instancing stays within budget: a ceiling on prototypes and a floor on instancedModelCount / modelCount.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "max_prototypes": {
              "type": "integer",
              "minimum": 0
            },
            "min_instance_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "prim-naming": {
          "type": "object",
          "description": "Prim names match a regex chosen by prim type and/or path glob; the first matching pattern wins.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "regex"
                ],
                "properties": {
                  "match": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "Glob on the prim type name; '*' = any."
                      },
                      "path": {
                        "type": "string",
                        "description": "Glob on the prim path, e.g. /World/**."
                      }
                    }
                  },
                  "regex": {
                    "type": "string"
                  }
                }
              }
            },
            "max_findings": {
              "type": "integer",
              "minimum": 1,
              "description": "Naming findings listed per file before the rest are summarised (default 50)."
            }
          }
        }
      },
      "patternProperties": {
        "^upstream:[^:]+:[^:]+$": {
          "type": "object",
          "description": "One OpenUSD validator, by its registry name.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paths"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "object",
            "description": "Per-rule settings, keyed by rule ID.",
            "x-unknown-label": "rule",
            "properties": {
              "unresolved-references": {
                "type": "object",
                "description": "References and payloads that point at files which cannot be found (usdUtilsValidators:MissingReferenceValidator, usdValidation:CompositionErrorTest).",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  }
                }
              },
              "unresolved-sublayers": {
                "type": "object",
                "description": "Sublayers that cannot be loaded (usdValidation:CompositionErrorTest, usdUtilsValidators:MissingReferenceValidator).",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  }
                }
              },
              "default-prim": {
                "type": "object",
                "description": "The stage has a valid defaultPrim (usdValidation:StageMetadataChecker), optionally of a required kind.",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "description": "Required kind on the default prim; derived kinds also pass."
                  }
                }
              },
              "stage-metadata": {
                "type": "object",
                "description": "upAxis and metersPerUnit are authored (usdGeomValidators:StageMetadataChecker) and, when configured, have the required values.",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "metersPerUnit": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "upAxis": {
                    "enum": [
                      "Y",
                      "Z"
                    ]
                  },
                  "tolerance": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Absolute tolerance for metersPerUnit (default 1e-9)."
                  }
                }
              },
              "file-size": {
                "type": "object",
                "description": "Each file stays under a size limit, checked before the stage is opened.",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "max_bytes": {
                    "description": "Bytes or a size such as 50MB (SI) / 2GiB (IEC), or a mapping from extension (.usd, .usda, .usdc, .usdz) or 'default' to a size.",
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "string",
                            "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([KMG]i?)?B\\s*$"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "default": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0
                              },
                              {
                                "type": "string",
                                "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([KMG]i?)?B\\s*$"
                              }
                            ]
                          }
                        },
                        "patternProperties": {
                          "^\\.usd[acz]?$": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0
                              },
                              {
                                "type": "string",
                                "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([KMG]i?)?B\\s*$"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "prim-budget": {
                "type": "object",
                "description": "Total and per-type prim counts stay within budget (UsdUtils.ComputeUsdStageStats, prototypes included).",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "max_prims": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_by_type": {
                    "type": "object",
                    "description": "Prim type name -> maximum count, e.g. {Mesh: 5000}.",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "instance-budget": {
                "type": "object",
                "description": "Instancing stays within budget: a ceiling on prototypes and a floor on instancedModelCount / modelCount.",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "max_prototypes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "min_instance_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "prim-naming": {
                "type": "object",
                "description": "Prim names match a regex chosen by prim type and/or path glob; the first matching pattern wins.",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "patterns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "regex"
                      ],
                      "properties": {
                        "match": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "type": "string",
                              "description": "Glob on the prim type name; '*' = any."
                            },
                            "path": {
                              "type": "string",
                              "description": "Glob on the prim path, e.g. /World/**."
                            }
                          }
                        },
                        "regex": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "max_findings": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Naming findings listed per file before the rest are summarised (default 50)."
                  }
                }
              }
            },
            "patternProperties": {
              "^upstream:[^:]+:[^:]+$": {
